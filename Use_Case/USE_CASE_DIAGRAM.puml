@startuml Modzy English - Use Case Diagram

!define RECTANGLE class

skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor<<User>> #E3F2FD
  BackgroundColor<<Teacher>> #FFF3E0
  BackgroundColor<<Admin>> #FFEBEE
  BorderColor #1976D2
}

title Modzy English - Use Case Diagram

' ============================================
' ACTORS
' ============================================
actor "Người dùng\n(User)" as User
actor "Giáo viên\n(Teacher)" as Teacher
actor "Quản trị viên\n(Admin)" as Admin

' ============================================
' AUTHENTICATION & USER MANAGEMENT
' ============================================
package "Xác thực & Quản lý Người dùng" {
  usecase "Đăng ký tài khoản" as UC_Register
  usecase "Đăng nhập" as UC_Login
  usecase "Đăng xuất" as UC_Logout
  usecase "Quên mật khẩu" as UC_ForgotPassword
  usecase "Đặt lại mật khẩu" as UC_ResetPassword
  usecase "Ghi nhớ đăng nhập" as UC_RememberMe
}

' ============================================
' USER PROFILE & SETTINGS
' ============================================
package "Hồ sơ & Cài đặt" {
  usecase "Xem hồ sơ cá nhân" as UC_ViewProfile
  usecase "Chỉnh sửa hồ sơ" as UC_EditProfile
  usecase "Tải ảnh đại diện" as UC_UploadProfileImage
  usecase "Xem lịch sử học tập" as UC_ViewLearningHistory
  usecase "Xem yêu thích" as UC_ViewFavorites
  usecase "Quản lý cài đặt" as UC_ManageSettings
  usecase "Xem trợ giúp" as UC_ViewHelp
}

' ============================================
' LEARNING CONTENT - LESSONS
' ============================================
package "Bài học (Lessons)" {
  usecase "Duyệt danh sách bài học" as UC_BrowseLessons
  usecase "Tìm kiếm bài học" as UC_SearchLessons
  usecase "Lọc bài học" as UC_FilterLessons
  usecase "Xem chi tiết bài học" as UC_ViewLessonDetail
  usecase "Phát video bài học" as UC_PlayLessonVideo
  usecase "Phát audio bài học" as UC_PlayLessonAudio
  usecase "Hoàn thành bài học" as UC_CompleteLesson
  usecase "Thêm vào yêu thích" as UC_AddLessonToFavorites
  usecase "Xem tiến độ bài học" as UC_ViewLessonProgress
}

' ============================================
' LEARNING CONTENT - VOCABULARY
' ============================================
package "Từ vựng (Vocabulary)" {
  usecase "Duyệt danh sách từ vựng" as UC_BrowseVocabulary
  usecase "Tìm kiếm từ vựng" as UC_SearchVocabulary
  usecase "Lọc từ vựng" as UC_FilterVocabulary
  usecase "Xem chi tiết từ vựng" as UC_ViewVocabularyDetail
  usecase "Luyện tập từ vựng" as UC_PracticeVocabulary
  usecase "Nghe phát âm" as UC_ListenPronunciation
  usecase "Đánh dấu từ vựng" as UC_BookmarkVocabulary
  usecase "Xóa đánh dấu" as UC_RemoveBookmark
  usecase "Thêm vào yêu thích" as UC_AddVocabularyToFavorites
}

' ============================================
' LEARNING CONTENT - QUIZ
' ============================================
package "Bài kiểm tra (Quiz)" {
  usecase "Duyệt danh sách quiz" as UC_BrowseQuizzes
  usecase "Tìm kiếm quiz" as UC_SearchQuizzes
  usecase "Lọc quiz" as UC_FilterQuizzes
  usecase "Làm bài quiz" as UC_TakeQuiz
  usecase "Xem kết quả quiz" as UC_ViewQuizResults
  usecase "Xem thống kê quiz" as UC_ViewQuizStatistics
}

' ============================================
' LEARNING CONTENT - VIDEOS
' ============================================
package "Video học tập" {
  usecase "Xem danh sách video" as UC_BrowseVideos
  usecase "Phát video" as UC_PlayVideo
  usecase "Thêm video yêu thích" as UC_AddVideoToFavorites
}

' ============================================
' INTERACTIVE LEARNING - MINI GAMES
' ============================================
package "Trò chơi Mini (Mini Games)" {
  usecase "Xem danh sách mini games" as UC_BrowseMiniGames
  usecase "Chơi Word Match Game" as UC_PlayWordMatch
  usecase "Chơi Word Scramble Game" as UC_PlayWordScramble
  usecase "Chơi Word Search Game" as UC_PlayWordSearch
  usecase "Xem điểm số game" as UC_ViewGameScore
  usecase "Xem lịch sử chơi game" as UC_ViewGameHistory
}

' ============================================
' SOCIAL FEATURES
' ============================================
package "Tính năng Xã hội" {
  usecase "Gửi lời mời kết bạn" as UC_SendFriendRequest
  usecase "Chấp nhận lời mời" as UC_AcceptFriendRequest
  usecase "Từ chối lời mời" as UC_RejectFriendRequest
  usecase "Hủy lời mời đã gửi" as UC_CancelFriendRequest
  usecase "Xem danh sách bạn bè" as UC_ViewFriendsList
  usecase "Xóa bạn bè" as UC_RemoveFriend
  usecase "Tạo thách đấu" as UC_CreateChallenge
  usecase "Chấp nhận thách đấu" as UC_AcceptChallenge
  usecase "Từ chối thách đấu" as UC_RejectChallenge
  usecase "Hoàn thành thách đấu" as UC_CompleteChallenge
  usecase "Xem kết quả thách đấu" as UC_ViewChallengeResults
}

' ============================================
' LEADERBOARD
' ============================================
package "Bảng xếp hạng" {
  usecase "Xem bảng xếp hạng" as UC_ViewLeaderboard
  usecase "Xem xếp hạng theo điểm" as UC_ViewScoreRanking
  usecase "Xem xếp hạng theo level" as UC_ViewLevelRanking
}

' ============================================
' ADMIN FEATURES
' ============================================
package "Tính năng Quản trị" {
  usecase "Xem bảng điều khiển Admin" as UC_ViewAdminDashboard
  usecase "Xem thống kê nền tảng" as UC_ViewPlatformStatistics
  
  package "Quản lý Người dùng" {
    usecase "Xem danh sách người dùng" as UC_ViewUsers
    usecase "Tìm kiếm người dùng" as UC_SearchUsers
    usecase "Chỉnh sửa thông tin người dùng" as UC_EditUser
    usecase "Vô hiệu hóa người dùng" as UC_DeactivateUser
    usecase "Kích hoạt người dùng" as UC_ActivateUser
    usecase "Thay đổi vai trò người dùng" as UC_ChangeUserRole
  }
  
  package "Quản lý Bài học" {
    usecase "Tạo bài học" as UC_CreateLesson
    usecase "Chỉnh sửa bài học" as UC_EditLesson
    usecase "Xóa bài học" as UC_DeleteLesson
    usecase "Tải lên media bài học" as UC_UploadLessonMedia
    usecase "Kích hoạt/Vô hiệu hóa bài học" as UC_ToggleLessonStatus
  }
  
  package "Quản lý Từ vựng" {
    usecase "Tạo từ vựng" as UC_CreateVocabulary
    usecase "Chỉnh sửa từ vựng" as UC_EditVocabulary
    usecase "Xóa từ vựng" as UC_DeleteVocabulary
    usecase "Tải lên phát âm" as UC_UploadPronunciation
  }
  
  package "Quản lý Quiz" {
    usecase "Tạo quiz" as UC_CreateQuiz
    usecase "Chỉnh sửa quiz" as UC_EditQuiz
    usecase "Xóa quiz" as UC_DeleteQuiz
    usecase "Xem thống kê quiz" as UC_ViewQuizStats
  }
  
  package "Quản lý Mini Games" {
    usecase "Tạo mini game" as UC_CreateMiniGame
    usecase "Chỉnh sửa mini game" as UC_EditMiniGame
    usecase "Xóa mini game" as UC_DeleteMiniGame
    usecase "Xem thống kê game" as UC_ViewGameStats
  }
  
  package "Quản lý Challenge Exercises" {
    usecase "Tạo bài tập challenge" as UC_CreateChallengeExercise
    usecase "Chỉnh sửa bài tập challenge" as UC_EditChallengeExercise
    usecase "Xóa bài tập challenge" as UC_DeleteChallengeExercise
  }
  
  package "Phân tích & Thống kê" {
    usecase "Xem phân tích người dùng" as UC_ViewUserAnalytics
    usecase "Xem phân tích nội dung" as UC_ViewContentAnalytics
    usecase "Xem báo cáo tiến độ" as UC_ViewProgressReports
  }
  
  package "Quản lý Media" {
    usecase "Tải lên media" as UC_UploadMedia
    usecase "Quản lý thư viện media" as UC_ManageMediaLibrary
  }
}

' ============================================
' TEACHER FEATURES
' ============================================
package "Tính năng Giáo viên" {
  usecase "Xem bảng điều khiển Giáo viên" as UC_ViewTeacherDashboard
  usecase "Xem thống kê nội dung của mình" as UC_ViewMyContentStats
  
  package "Quản lý Bài học (Teacher)" {
    usecase "Tạo bài học (Teacher)" as UC_CreateLessonTeacher
    usecase "Chỉnh sửa bài học (Teacher)" as UC_EditLessonTeacher
  }
  
  package "Quản lý Từ vựng (Teacher)" {
    usecase "Tạo từ vựng (Teacher)" as UC_CreateVocabularyTeacher
    usecase "Chỉnh sửa từ vựng (Teacher)" as UC_EditVocabularyTeacher
  }
  
  package "Quản lý Quiz (Teacher)" {
    usecase "Tạo quiz (Teacher)" as UC_CreateQuizTeacher
    usecase "Chỉnh sửa quiz (Teacher)" as UC_EditQuizTeacher
  }
  
  package "Quản lý Mini Games (Teacher)" {
    usecase "Tạo mini game (Teacher)" as UC_CreateMiniGameTeacher
    usecase "Chỉnh sửa mini game (Teacher)" as UC_EditMiniGameTeacher
  }
  
  package "Quản lý Challenge Exercises (Teacher)" {
    usecase "Tạo bài tập challenge (Teacher)" as UC_CreateChallengeExerciseTeacher
    usecase "Chỉnh sửa bài tập challenge (Teacher)" as UC_EditChallengeExerciseTeacher
  }
}

